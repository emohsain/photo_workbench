<h1><%= @photo.title %></h1>

<% if @photo.image.attached? %>
  <%= image_tag @photo.image %>
<% end %>

<p><strong>Description:</strong> <%= @photo.description %></p>
<p><strong>Taken at:</strong> <%= @photo.taken_at %></p>

<%= link_to "Delete this photo", @photo, data: { turbo_method: :delete, turbo_confirm: "Are you sure?" } 
<%= link_to "Edit this photo", edit_photo_path(@photo) %>
<%= link_to "Back to all photos", photos_path %>
