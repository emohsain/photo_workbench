<h1>All Photos</h1>

<%= link_to "Upload a new photo", new_photo_path %>

<% @photos.each do |photo| %>
  <div>
    <h2><%= link_to photo.title, photo %></h2>

    <% if photo.image.attached? %>
      <%= image_tag photo.image, width: 200 %>
    <% end %>

    <p><%= photo.description %></p>

 <%= link_to "Edit", edit_photo_path(photo) %> |
    <%= link_to "Delete", photo, data: { turbo_method: :delete, turbo_confirm: "Are you sure?" } %>
  </div>
<% end %>
  
