<h1>Edit Photo</h1>

<%= form_with model: @photo do |form| %>

<% if @photo.errors.any? %>
  <div style="color: red;">
    <h3><%= pluralize(@photo.errors.count, "error") %> prevented this photo from being saved:</h3>
    <ul>
      <% @photo.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

  <div>
    <%= form.label :title %>
    <%= form.text_field :title %>
  </div>

  <div>
    <%= form.label :description %>
    <%= form.text_area :description %>
  </div>

  <div>
    <%= form.label :taken_at %>
    <%= form.datetime_field :taken_at %>
  </div>

  <div>
    <%= form.label :image %>
    <%= form.file_field :image %>
  </div>

  <%= form.submit "Update" %>
<% end %>
